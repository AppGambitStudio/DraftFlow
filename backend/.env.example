# ===========================================
# DraftFlow Backend — Environment Variables
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Database
DATABASE_URL="file:./dev.db"

# Server
PORT=5002

# JWT Secret (REQUIRED — generate a random string)
# Example: openssl rand -base64 32
JWT_SECRET=

# Frontend URL (used for invitation links, CORS)
FRONTEND_URL=http://localhost:3000

# LinkedIn OAuth (optional — can also be configured in Settings UI)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Twitter/X OAuth (optional — can also be configured in Settings UI)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
